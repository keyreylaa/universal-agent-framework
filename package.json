{
  "name": "universal-agent-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Shared skills, memory, and safety workflows for Claude Code, Codex CLI, OpenCode, and Oh My Pi.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "uaf": "./core/cli.mjs"
  },
  "files": [
    "core",
    "skills",
    "commands",
    "hooks",
    "adapters",
    "templates"
  ],
  "scripts": {
    "test": "node tests/run.mjs tests/unit tests/integration tests/security",
    "test:e2e": "node tests/run.mjs tests/e2e",
    "test:all": "npm test && npm run test:e2e",
    "doctor": "node core/cli.mjs doctor",
    "compat": "node core/cli.mjs compat",
    "skills": "node core/cli.mjs skills",
    "install:project": "node core/cli.mjs install --dry-run"
  }
}
